{
    "compilerOptions": {
        "declaration": true,
        "allowJs": true,
        "baseUrl": "./",
        "downlevelIteration": true,
        "strict": false,
        "target": "ES2017",
        "jsx": "react-jsx",
        "jsxImportSource": "src",
        "lib": ["ES2019", "dom"],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "skipLibCheck": true
    },
    "include": ["./src"]
}
